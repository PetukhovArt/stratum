{
  "version": 1,
  "structure": {
    "segments": [
      "model"
    ],
    "private": [
      "_shared"
    ]
  },
  "layers": [
    {
      "id": "modules",
      "path": "src/modules",
      "depends_on": [],
      "slices": true
    }
  ],
  "rules": {
    "stratum/zone-breadth": {
      "severity": "error",
      "options": {
        "max_kinds": 3
      }
    }
  }
}
