{
  "version": 1,
  "structure": {
    "segments": [
      "model"
    ],
    "private": [
      "_shared"
    ]
  },
  "layers": [
    {
      "id": "modules",
      "path": "src/modules",
      "depends_on": [
        "shared"
      ],
      "slices": true
    },
    {
      "id": "shared",
      "path": "src/shared",
      "depends_on": []
    }
  ],
  "rules": {
    "stratum/container-breadth": {
      "severity": "off"
    },
    "stratum/no-barrel": {
      "severity": "error",
      "options": {
        "layers": [
          "shared"
        ]
      }
    }
  }
}
