---
source: crates/stratum-lint/tests/e2e_c4.rs
expression: shared
---
workspace "Components of shared" {
    model {
        sys_tiny_ts = softwareSystem "tiny-ts" "" {
            ctr_src_shared = container "shared" "3 modules" "layer" {
                cmp_src_shared_api = component "api" "1 module" "folder"
                cmp_src_shared_ui = component "ui" "1 module" "folder"
                cmp_src_shared_utils = component "utils" "1 module" "folder"
            }
        }
    }
    views {
        component ctr_src_shared "components" {
            include *
            autoLayout
        }
        styles {
            element "External" {
                background #999999
                color #ffffff
            }
        }
    }
}
