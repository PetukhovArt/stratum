$schema: "http://json-schema.org/draft-07/schema#"
title: Config
description: "The whole `stratum.config.jsonc` document."
type: object
required:
  - layers
  - project
  - version
properties:
  layers:
    type: array
    items:
      $ref: "#/definitions/LayerConfig"
  overrides:
    default: []
    type: array
    items:
      $ref: "#/definitions/OverrideBlock"
  project:
    $ref: "#/definitions/ProjectConfig"
  rules:
    default: {}
    type: object
    additionalProperties:
      $ref: "#/definitions/RuleConfig"
  version:
    type: integer
    format: uint32
    minimum: 0
definitions:
  LayerConfig:
    type: object
    required:
      - id
      - path
    properties:
      depends_on:
        default: []
        type: array
        items:
          type: string
      id:
        type: string
      path:
        type: string
  OverrideBlock:
    type: object
    required:
      - files
    properties:
      files:
        type: array
        items:
          type: string
      rules:
        default: {}
        type: object
        additionalProperties:
          $ref: "#/definitions/RuleConfig"
  ProjectConfig:
    type: object
    required:
      - root
    properties:
      extends:
        default: ~
        type:
          - string
          - "null"
      root:
        type: string
  RuleConfig:
    type: object
    required:
      - severity
    properties:
      options:
        default: ~
      script:
        default: ~
        type:
          - string
          - "null"
      severity:
        $ref: "#/definitions/Severity"
  Severity:
    type: string
    enum:
      - "off"
      - info
      - warning
      - error
