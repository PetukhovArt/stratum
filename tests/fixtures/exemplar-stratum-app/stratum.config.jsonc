{
  "version": 1,
  "project": { "root": "./src" },
  "layers": [
    { "id": "app",      "path": "src/app",      "depends_on": ["features", "entities", "shared"] },
    { "id": "features", "path": "src/features", "depends_on": ["entities", "shared"] },
    { "id": "entities", "path": "src/entities", "depends_on": ["shared"] },
    { "id": "shared",   "path": "src/shared",   "depends_on": [] }
  ],
  "rules": {
    "stratum/no-cross-layer-import":  { "severity": "error" },
    "stratum/no-circular-deps":       { "severity": "error" },
    "stratum/stage-purity":           { "severity": "warning" },
    "stratum/miller-limit":           { "severity": "warning", "options": { "max_children": 3 } },
    "stratum/depth-ratio":            { "severity": "info" },
    "stratum/visibility-scope":       { "severity": "error" },
    "stratum/cross-entity-pattern":   { "severity": "warning", "options": { "max_fanout": 2 } },
    "stratum/deep-module":            { "severity": "info", "options": { "max_exports": 5 } },
    "stratum/promotion-pressure":     { "severity": "info", "options": { "threshold": 3 } }
  }
}
