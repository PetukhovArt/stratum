{
  "version": 1,
  "structure": { "segments": ["model", "ui", "api", "lib"], "private": ["_shared"] },
  "layers": [
    { "id": "app",      "path": "src/app",      "depends_on": ["features", "entities", "shared"] },
    { "id": "features", "path": "src/features", "depends_on": ["entities", "shared"], "slices": true },
    { "id": "entities", "path": "src/entities", "depends_on": ["shared"], "slices": true },
    { "id": "shared",   "path": "src/shared",   "depends_on": [] }
  ],
  "rules": {
    "stratum/no-cross-layer-import":  { "severity": "error" },
    "stratum/no-circular-deps":       { "severity": "error" },
    "stratum/purity":           { "severity": "warning" },
    "stratum/miller-limit":           { "severity": "warning", "options": { "max_children": 2 } },
    "stratum/depth-ratio":            { "severity": "info", "options": { "min_ratio": 3.0 } },
    "stratum/visibility-scope":       { "severity": "error" },
    "stratum/public-api":             { "severity": "error" },
    "stratum/sibling-isolation":      { "severity": "error" },
    "stratum/restricted-calls":       {
      "severity": "warning",
      "options": [{ "calls": ["inject"], "allow": ["**/_shared/*-scope.ts"], "message": "Use a scope hook" }]
    },
    "stratum/stage-mixing":           { "severity": "error" },
    "stratum/container-breadth":      { "severity": "warning", "options": { "max_kinds": 3 } },
    "stratum/slice-fan-in":           { "severity": "warning", "options": { "max_fan_in": 1 } },
    "stratum/deep-module":            { "severity": "info", "options": { "max_exports": 5 } },
    "stratum/promotion-pressure":     { "severity": "info", "options": { "threshold": 1 } }
  }
}
