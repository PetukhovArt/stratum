{
  "version": 1,
  "layers": [
    { "id": "app",      "path": "src/app",      "depends_on": ["features", "shared"] },
    { "id": "features", "path": "src/features", "depends_on": ["shared"] },
    { "id": "shared",   "path": "src/shared",   "depends_on": [] }
  ],
  "rules": {
    "stratum/no-cross-layer-import": { "severity": "error" },
    "stratum/no-circular-deps":      { "severity": "error" },
    "stratum/purity":          { "severity": "error" },
    "stratum/miller-limit":          { "severity": "warning", "options": { "max_children": 7 } },
    "stratum/depth-ratio":           { "severity": "info",    "options": { "min_ratio": 3.0 } },
    "stratum/container-breadth":     { "severity": "off" }
  },
  "overrides": [
    {
      "files": ["src/shared/api/**"],
      "rules": {
        "stratum/no-cross-layer-import": { "severity": "warning" }
      }
    }
  ]
}
