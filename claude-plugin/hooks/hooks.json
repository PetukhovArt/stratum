{
  "description": "Stratum architecture check of each edited file and a gate on changed files at the end of each turn",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "stratum-lint hook",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "stratum-lint hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
